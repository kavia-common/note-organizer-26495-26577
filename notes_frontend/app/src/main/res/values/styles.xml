<resources>

    <style name="Theme.OceanProfessional" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/op_primary</item>
        <item name="colorPrimaryVariant">@color/op_primary_dark</item>
        <item name="colorSecondary">@color/op_secondary</item>
        <item name="android:statusBarColor">@color/op_primary_dark</item>
        <item name="android:navigationBarColor">@color/op_bg</item>

        <item name="android:colorBackground">@color/op_bg</item>
        <item name="android:textColor">@color/op_text</item>

        <item name="materialCardViewStyle">@style/Ocean.Card</item>
        <item name="toolbarStyle">@style/Ocean.Toolbar</item>
        <item name="android:buttonStyle">@style/Ocean.Button</item>
        <item name="floatingActionButtonStyle">@style/Ocean.Fab</item>
    </style>

    <style name="Ocean.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@drawable/bg_toolbar_gradient</item>
        <item name="titleTextColor">@color/op_surface</item>
        <item name="subtitleTextColor">@color/op_surface</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="Ocean.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/op_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Ocean.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Ocean.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/op_primary</item>
        <item name="rippleColor">@color/op_secondary</item>
    </style>

</resources>
